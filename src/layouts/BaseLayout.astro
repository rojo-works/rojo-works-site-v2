---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/header.css';
import '../styles/section.css';
import '../styles/footer.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = '路 R O J O 上 — rojo.works',
  description = '路 R O J O 上 (rojo.works) — A practice in Ueda. Articles · Dialog · Small Rental Property.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2b2b2b" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://rojo.works/" />
    <meta property="og:site_name" content="路 R O J O 上" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link
      rel="preload"
      href="/assets/fonts/jetbrains-mono-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/line-seed-jp-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <Header />

    <main id="top" class="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
