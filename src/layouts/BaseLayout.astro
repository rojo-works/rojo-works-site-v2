---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/header.css';
import '../styles/section.css';
import '../styles/footer.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = '路 R O J O 上 — rojo.works',
  description = '路 R O J O 上 (rojo.works) — A practice in Ueda. Articles · Dialog · Small Rental Property.',
} = Astro.props;

const navItems = [
  { href: '#articles', label: 'ARTICLES' },
  { href: '#dialogs', label: 'DIALOGS' },
  { href: '#rentals', label: 'RENTALS' },
  { href: '#contact', label: 'CONTACT' },
];
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2b2b2b" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://rojo.works/" />
    <meta property="og:site_name" content="路 R O J O 上" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link
      rel="preload"
      href="/assets/fonts/jetbrains-mono-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/line-seed-jp-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <header class="site-header">
      <a href="#top" class="brand" aria-label="路 R O J O 上 ホーム">
        <img class="logo" src="/assets/logo.svg" alt="路 R O J O 上" width="40" height="40" />
        <span class="brand-name">路 R O J O 上</span>
      </a>

      <nav class="nav" aria-label="主要ナビゲーション">
        {navItems.map((item) => (
          <a href={item.href} class="nav-link">{item.label}</a>
        ))}
      </nav>
    </header>

    <main id="top" class="main">
      <slot />
    </main>

    <div class="site-footer-wrap">
      <footer class="site-footer">
        <p>Cookie の使用、アクセス解析、外部トラッキングは行っていません。</p>
        <p>© 2026 路上</p>
      </footer>
    </div>
  </body>
</html>
